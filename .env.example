# Salin ke .env lalu isi. Jangan commit .env.

# URL kanonik situs, tanpa trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon: endpoint pooled (host berakhiran -pooler), dipakai aplikasi
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Neon: koneksi langsung, dipakai drizzle-kit migrate
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Garam hash IP untuk rate limit form kontak (acak, minimal 16 karakter)
IP_HASH_SALT=ganti-dengan-string-acak-panjang
